{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oldap/archive-structure/v1",
  "$comment": "AS-00 frozen wire schemas; domain validation and HTTP bindings are defined in contracts.md. Not a deployed API.",
  "$defs": {
    "Iri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^(https?://|urn:)[^\\s<>\"{}|\\\\^`]+$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "OperationId": {
      "type": "string",
      "format": "uuid"
    },
    "Revision": {
      "$ref": "#/$defs/Digest"
    },
    "Target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "iri": {
              "$ref": "#/$defs/Iri"
            }
          },
          "required": [
            "iri"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Name": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "patternProperties": {
        "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    },
    "NewUnit": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "$ref": "#/$defs/Name"
        },
        "archiveLevel": {
          "enum": [
            "shared:ArchiveGroup",
            "shared:Fonds",
            "shared:Subfonds",
            "shared:Series",
            "shared:Subseries",
            "shared:File",
            "shared:Item"
          ]
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "key",
        "name",
        "archiveLevel",
        "parent"
      ],
      "additionalProperties": false
    },
    "Mapping": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "folderIri": {
              "$ref": "#/$defs/Iri"
            },
            "action": {
              "const": "set"
            },
            "target": {
              "$ref": "#/$defs/Target"
            }
          },
          "required": [
            "folderIri",
            "action",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "folderIri": {
              "$ref": "#/$defs/Iri"
            },
            "action": {
              "enum": [
                "clear",
                "skip"
              ]
            }
          },
          "required": [
            "folderIri",
            "action"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Plan": {
      "type": "object",
      "properties": {
        "sourceFolderIri": {
          "$ref": "#/$defs/Iri"
        },
        "sourceSnapshot": {
          "$ref": "#/$defs/Digest"
        },
        "newUnits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NewUnit"
          },
          "maxItems": 500
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mapping"
          },
          "maxItems": 500
        }
      },
      "required": [
        "sourceFolderIri",
        "sourceSnapshot",
        "newUnits",
        "mappings"
      ],
      "additionalProperties": false
    },
    "ProposalRequest": {
      "type": "object",
      "properties": {
        "sourceFolderIri": {
          "$ref": "#/$defs/Iri"
        }
      },
      "required": [
        "sourceFolderIri"
      ],
      "additionalProperties": false
    },
    "PreflightRequest": {
      "type": "object",
      "properties": {
        "plan": {
          "$ref": "#/$defs/Plan"
        }
      },
      "required": [
        "plan"
      ],
      "additionalProperties": false
    },
    "ApplyRequest": {
      "type": "object",
      "properties": {
        "plan": {
          "$ref": "#/$defs/Plan"
        },
        "reviewDigest": {
          "$ref": "#/$defs/Digest"
        },
        "confirm": {
          "const": true
        }
      },
      "required": [
        "plan",
        "reviewDigest",
        "confirm"
      ],
      "additionalProperties": false
    },
    "ReferenceMoveRequest": {
      "type": "object",
      "properties": {
        "mediaIri": {
          "$ref": "#/$defs/Iri"
        },
        "sourceFolderIri": {
          "$ref": "#/$defs/Iri"
        },
        "targetFolderIri": {
          "$ref": "#/$defs/Iri"
        },
        "sourceRevision": {
          "$ref": "#/$defs/Revision"
        },
        "targetRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "mediaIri",
        "sourceFolderIri",
        "targetFolderIri",
        "sourceRevision",
        "targetRevision"
      ],
      "additionalProperties": false
    },
    "Warning": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "FolderRow": {
      "type": "object",
      "properties": {
        "iri": {
          "$ref": "#/$defs/Iri"
        },
        "parentIri": {
          "oneOf": [
            {
              "$ref": "#/$defs/Iri"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 1000
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "defaultArchiveUnitIri": {
          "oneOf": [
            {
              "$ref": "#/$defs/Iri"
            },
            {
              "type": "null"
            }
          ]
        },
        "mappingState": {
          "enum": [
            "unmapped",
            "mapped",
            "unavailable"
          ]
        },
        "protected": {
          "type": "boolean"
        }
      },
      "required": [
        "iri",
        "parentIri",
        "name",
        "revision",
        "defaultArchiveUnitIri",
        "mappingState",
        "protected"
      ],
      "additionalProperties": false
    },
    "ProposalResponse": {
      "type": "object",
      "properties": {
        "sourceFolderIri": {
          "$ref": "#/$defs/Iri"
        },
        "stagingAreaIri": {
          "$ref": "#/$defs/Iri"
        },
        "sourceSnapshot": {
          "$ref": "#/$defs/Digest"
        },
        "folders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FolderRow"
          },
          "maxItems": 5000
        },
        "suggestedPlan": {
          "$ref": "#/$defs/Plan"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "maxItems": 100
        }
      },
      "required": [
        "sourceFolderIri",
        "stagingAreaIri",
        "sourceSnapshot",
        "folders",
        "suggestedPlan",
        "warnings"
      ],
      "additionalProperties": false
    },
    "PreflightResponse": {
      "type": "object",
      "properties": {
        "reviewDigest": {
          "$ref": "#/$defs/Digest"
        },
        "counts": {
          "type": "object",
          "properties": {
            "create": {
              "type": "integer",
              "minimum": 0
            },
            "set": {
              "type": "integer",
              "minimum": 0
            },
            "clear": {
              "type": "integer",
              "minimum": 0
            },
            "skip": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "create",
            "set",
            "clear",
            "skip"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "maxItems": 100
        }
      },
      "required": [
        "reviewDigest",
        "counts",
        "warnings"
      ],
      "additionalProperties": false
    },
    "ApplyResponse": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/$defs/OperationId"
        },
        "state": {
          "const": "committed"
        },
        "reviewDigest": {
          "$ref": "#/$defs/Digest"
        },
        "createdUnits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "iri": {
                "$ref": "#/$defs/Iri"
              }
            },
            "required": [
              "key",
              "iri"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "folderIri": {
                "$ref": "#/$defs/Iri"
              },
              "targetIri": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/Iri"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "folderIri",
              "targetIri"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        }
      },
      "required": [
        "operationId",
        "state",
        "reviewDigest",
        "createdUnits",
        "mappings"
      ],
      "additionalProperties": false
    },
    "ReferenceMoveResponse": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/$defs/OperationId"
        },
        "state": {
          "const": "committed"
        },
        "mediaIri": {
          "$ref": "#/$defs/Iri"
        },
        "sourceFolderIri": {
          "$ref": "#/$defs/Iri"
        },
        "targetFolderIri": {
          "$ref": "#/$defs/Iri"
        },
        "sourceRevision": {
          "$ref": "#/$defs/Revision"
        },
        "targetRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "operationId",
        "state",
        "mediaIri",
        "sourceFolderIri",
        "targetFolderIri",
        "sourceRevision",
        "targetRevision"
      ],
      "additionalProperties": false
    },
    "InventoryEntry": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "stagingMedia",
            "archiveReference"
          ]
        },
        "mediaIri": {
          "$ref": "#/$defs/Iri"
        },
        "title": {
          "type": "string",
          "maxLength": 1000
        },
        "canDownloadOriginal": {
          "type": "boolean"
        },
        "canEditMetadata": {
          "type": "boolean"
        },
        "canMove": {
          "type": "boolean"
        },
        "canDeleteMedia": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "mediaIri",
        "title",
        "canDownloadOriginal",
        "canEditMetadata",
        "canMove",
        "canDeleteMedia"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "archiveReference"
              }
            }
          },
          "then": {
            "properties": {
              "canEditMetadata": {
                "const": false
              },
              "canDeleteMedia": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "InventoryResponse": {
      "type": "object",
      "properties": {
        "folderIri": {
          "$ref": "#/$defs/Iri"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InventoryEntry"
          },
          "maxItems": 100
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "maxItems": 100
        }
      },
      "required": [
        "folderIri",
        "revision",
        "entries",
        "nextCursor",
        "warnings"
      ],
      "additionalProperties": false
    },
    "CapabilitiesResponse": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "canManageStructure": {
          "type": "boolean"
        },
        "canCreateUnits": {
          "type": "boolean"
        },
        "maxSourceFolders": {
          "const": 5000
        },
        "maxMutations": {
          "const": 500
        },
        "maxRequestBytes": {
          "const": 2000000
        }
      },
      "required": [
        "enabled",
        "canManageStructure",
        "canCreateUnits",
        "maxSourceFolders",
        "maxMutations",
        "maxRequestBytes"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "TOO_LARGE",
            "FORBIDDEN",
            "NOT_FOUND",
            "STALE_REVIEW",
            "STALE_FOLDER",
            "INVALID_HIERARCHY",
            "REFERENCE_IN_USE",
            "IDEMPOTENCY_CONFLICT",
            "COORDINATION_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "requestId": {
          "$ref": "#/$defs/OperationId"
        }
      },
      "required": [
        "code",
        "message",
        "requestId"
      ],
      "additionalProperties": false
    }
  }
}
