# Copy to a private 0600 file; replace each secret with a distinct random value.
# Use an absolute, NEW dataset path only with the explicit first-start --init.
dataset=/var/lib/oldap-jena/dataset
port=3031
transactionLifetimeMillis=30000
identityUrl=http://127.0.0.1:8001/internal/jena/identity
identitySecret=REPLACE_WITH_RANDOM_IDENTITY_SECRET
serviceSecret=REPLACE_WITH_RANDOM_TRANSPORT_SECRET
bootstrapSecret=REPLACE_WITH_RANDOM_BOOTSTRAP_SECRET
fulltextSecret=REPLACE_WITH_RANDOM_FULLTEXT_SECRET

# Optional official Fuseki administration; supply all three values together.
# The native listener shares this process/dataset and must sit behind the
# authenticated proxy, which injects X-Oldap-Admin-Key. Do not publish its port.
# adminPort=8040
# adminSecret=<separate random transport secret, at least 32 characters>
# adminOrigin=https://fuseki.home.org

# Optional growth-triggered native compaction (all seven keys required).
# Enable only with the matching new service release and a verified backup.
# Check every 15 minutes; compact at most daily, after >=512 MiB AND >=2x growth.
# First run without a baseline is eligible at >=512 MiB. Requires space for a
# second complete generation plus a 20% filesystem reserve. Preserves receipts.
# compactionCheckSeconds=900
# compactionMinSeconds=86400
# compactionGrowthBytes=536870912
# compactionGrowthRatio=2.0

# Start maintenance only during the local night; an active run finishes safely.
# compactionZone=Europe/Zurich
# compactionWindowStart=01:00
# compactionWindowEnd=03:00
